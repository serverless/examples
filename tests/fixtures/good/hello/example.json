{
  "title": "Hello function",
  "description": "A minimal example used by the checker tests.",
  "language": "node",
  "platform": "AWS",
  "framework": "v4",
  "author": {
    "name": "Serverless, Inc.",
    "link": "https://github.com/serverless",
