  "services": ["lambda"],
  "test": {
    "tier": "fast",
    "checks": [
      { "invoke": { "function": "hello", "event": "events/hello.json", "contains": "Hello" } },
      { "script": { "path": "test/smoke.mjs" } }
    ]
  }
}
