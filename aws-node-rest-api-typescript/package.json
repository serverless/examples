    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.0",
    "@types/sinon": "^22.0.0",
    "chai": "^6.2.2",
    "cross-env": "^10.1.0",
    "lambda-tester": "^4.0.1",
    "mocha": "^11.7.6",
    "nyc": "^18.0.0",
    "serverless-offline": "^14.7.4",
    "sinon": "^22.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
