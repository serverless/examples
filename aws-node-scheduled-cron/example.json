{
  "title": "AWS Node Scheduled Cron example in NodeJS",
  "description": "A Node.js function on AWS Lambda that runs once a minute, triggered by the Serverless Framework schedule event.",
  "language": "node",
  "platform": "AWS",
  "framework": "v4",
  "priority": 4,
  "author": {
    "name": "Rob Abbott",
    "link": "https://github.com/0dj0bz",
    "avatar": "https://avatars3.githubusercontent.com/u/5679763?v=4&s=140"
  },
  "services": [
    "lambda",
    "eventbridge",
    "iam",
    "logs"
  ],
  "onboarding": true,
  "test": {
    "tier": "fast",
    "checks": [
      {
        "invoke": {
          "function": "rateHandler",
          "args": [
            "--log"
          ],
          "contains": "Your cron function ran at"
        }
      }
    ]
  }
